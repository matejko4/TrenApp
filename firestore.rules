rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Je aktuální uživatel členem daného týmu (jakoukoliv rolí)?
    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamCoach(teamId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach';
    }

    // Správce týmu (teams/{teamId}.ownerUid) – kdo tým založil, nebo komu
    // bylo vedení předáno.
    function teamOwner(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid;
    }

    function isTeamOwner(teamId) {
      return isSignedIn() && teamOwner(teamId) == request.auth.uid;
    }

    // users/{uid} – veřejný profil uživatele (jméno, email atd.)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isMe(uid);
      allow update: if isMe(uid);
      allow delete: if false;

      // users/{uid}/teams/{teamId} – přehled týmů daného uživatele a jeho
      // role v nich. Zakládá si ho sám uživatel (při založení týmu nebo
      // připojení kódem). Jinému členovi ho smí upravit správce (změna
      // role, předání vedení) a smazat trenér (odebrání hráče, zrušení týmu).
      match /teams/{teamId} {
        allow read: if isMe(uid) || isTeamCoach(teamId);
        allow create, update: if isMe(uid) || isTeamOwner(teamId);
        allow delete: if isMe(uid) || isTeamCoach(teamId);
      }
    }

    // teams/{teamId} – základní údaje týmu (název, kód, správce)
    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      // Kdo tým zakládá, je jeho správcem.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Jediná povolená úprava týmu je předání vedení
      // (TeamService.transferOwnership): smí jen správce, mění se jen
      // ownerUid a nový správce musí být po dávce trenérem týmu (hráče
      // stejná dávka povýší). Ostatní pole (název, kód) jsou zamčená.
      allow update: if isTeamOwner(teamId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']) &&
        getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.ownerUid)).data.role == 'coach';
      // Zrušení týmu smí jen správce. Batch v TeamService.deleteTeam maže
      // spolu s tímto dokumentem i celý roster, tréninky a team_codes –
      // pravidla pro celou dávku se vyhodnocují vůči stavu databáze před
      // dávkou, takže isTeamOwner(teamId) tu platí, i když se v téže dávce
      // maže i tým samotný.
      allow delete: if isTeamOwner(teamId);

      // teams/{teamId}/members/{uid} – roster týmu
      match /members/{uid} {
        // isMe(uid) navíc (nejen isTeamMember) dovoluje uživateli ověřit
        // si existenci VLASTNÍHO členství ještě předtím, než je členem
        // (TeamService.joinTeamByCode kontroluje, jestli už v týmu není).
        allow read: if isMe(uid) || isTeamMember(teamId);
        // Připojení kódem: kdokoliv přihlášený se smí přidat sám sobě,
        // ale jen jako 'player'. Role 'coach' smí vzniknout jen pro
        // správce týmu při jeho založení (TeamService.createTeam) – tým
        // vzniká ve stejné dávce, proto getAfter() (stav po celé dávce).
        allow create: if isMe(uid) && (
          request.resource.data.role == 'player' ||
          (request.resource.data.role == 'coach' &&
            getAfter(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid)
        );
        // Roli (povýšení na trenéra i změnu na hráče) mění jen správce a
        // sebe na hráče změnit nemůže – tým by zůstal bez správce-trenéra
        // (TeamService.updateMemberRole má stejnou kontrolu). Člen si navíc
        // smí sám změnit své jméno (AuthService.updateName) – ale nic jiného,
        // hlavně ne roli.
        allow update: if (
          isTeamOwner(teamId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          request.resource.data.role in ['coach', 'player'] &&
          !(uid == teamOwner(teamId) && request.resource.data.role == 'player')
        ) || (
          isMe(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        );
        // Hráče smí odebrat každý trenér, trenéra jen správce. Správce sám
        // odebrat nejde (TeamService.removeMember má stejnou kontrolu) –
        // výjimkou je zrušení celého týmu (TeamService.deleteTeam), kdy se
        // ve stejné dávce maže i teams/{teamId}, což ověří existsAfter()
        // (existsAfter/getAfter vyhodnocují stav PO celé dávce, ne jen po
        // tomto jednom zápisu).
        allow delete: if (isTeamCoach(teamId) && resource.data.role == 'player') ||
          (isTeamOwner(teamId) && (
            uid != teamOwner(teamId) ||
            !existsAfter(/databases/$(database)/documents/teams/$(teamId))
          ));
      }

      // teams/{teamId}/trainings/{trainingId} – tréninky týmu (viz
      // TrainingService). Odpovědi hráčů jsou v mapě responses (uid -> odpověď).
      match /trainings/{trainingId} {
        function isValidTraining(data) {
          return data.kind in ['team', 'individual'] &&
            data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
            data.type in ['run', 'strength', 'technique', 'recovery', 'other'] &&
            data.startAt is timestamp &&
            (data.get('endAt', null) == null || data.endAt is timestamp) &&
            data.assignedTo is list &&
            (data.kind == 'team' || data.assignedTo.size() > 0) &&
            data.responses is map;
        }

        // Hráč smí v tréninku změnit jen svůj vlastní klíč v responses:
        // u společného tréninku BUDU/NEBUDU ('yes'/'no'), u individuálního
        // jen 'done' a jen pokud je mu trénink zadaný. Smazání klíče
        // (zpět na „bez odpovědi“ / „naplánovaný“) je taky povolené.
        function isOwnResponseUpdate() {
          let uid = request.auth.uid;
          let after = request.resource.data;
          return isTeamMember(teamId) &&
            after.diff(resource.data).affectedKeys().hasOnly(['responses']) &&
            after.responses.diff(resource.data.responses).affectedKeys().hasOnly([uid]) &&
            (!(uid in after.responses) ||
              (after.kind == 'team' && after.responses[uid] in ['yes', 'no']) ||
              (after.kind == 'individual' && uid in after.assignedTo &&
                after.responses[uid] == 'done'));
        }

        // Trenér vidí všechny tréninky týmu, hráč jen společné a individuální
        // zadané jemu. Pravidla nejsou filtr – hráčské dotazy v TrainingService
        // proto samy omezují výsledky (kind == 'team', resp. assignedTo
        // array-contains uid), jinak by je Firestore celé zamítl.
        allow read: if isTeamCoach(teamId) || (isTeamMember(teamId) && (
          resource.data.kind == 'team' || request.auth.uid in resource.data.assignedTo
        ));
        allow create: if isTeamCoach(teamId) &&
          isValidTraining(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.responses.size() == 0;
        allow update: if (isTeamCoach(teamId) && isValidTraining(request.resource.data)) ||
          isOwnResponseUpdate();
        // Mazání i při rušení celého týmu (TeamService.deleteTeam) – pravidla
        // dávky se vyhodnocují vůči stavu před ní, takže trenér tu pořád je.
        allow delete: if isTeamCoach(teamId);
      }
    }

    // team_codes/{code} – vyhledávací mapa "pozvánkový kód -> tým", doc id
    // je přímo kód. Umožňuje připojení k týmu přímým get() podle id, což
    // funguje i pro uživatele, kteří (zatím) nejsou členy žádného týmu –
    // na rozdíl od dotazu nad kolekcí teams (viz komentář v TeamService).
    // list je zakázaný, aby nešlo kódy hromadně vypsat/uhodnout skenováním.
    match /team_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      // Kód vzniká ve stejné dávce jako tým (TeamService.createTeam),
      // proto getAfter() – stav po celé dávce.
      allow create: if isSignedIn() &&
        getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      // Smazání kódu je součástí rušení týmu (TeamService.deleteTeam) –
      // smí jen správce týmu, na který kód odkazuje.
      allow delete: if isTeamOwner(resource.data.teamId);
    }
  }
}
