rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Je aktuální uživatel členem daného týmu (jakoukoliv rolí)?
    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamCoach(teamId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach';
    }

    // Správce týmu (teams/{teamId}.ownerUid) – kdo tým založil, nebo komu
    // bylo vedení předáno.
    function teamOwner(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid;
    }

    function isTeamOwner(teamId) {
      return isSignedIn() && teamOwner(teamId) == request.auth.uid;
    }

    // Jméno uživatele – text o 1 až 40 znacích (stejně jako
    // AuthService._checkName). Jméno vidí ostatní členové týmu na soupisce,
    // a kdyby šlo uložit třeba číslo, aplikace by jim detail týmu neukázala.
    function isValidName(name) {
      return name is string && name.size() > 0 && name.size() <= 40;
    }

    // Jméno v dokumentu chybět smí (Google účet bez jména – aplikace si ho
    // pak vyžádá), ale když tam je, musí být platné.
    function hasValidNameIfAny(data) {
      return data.get('name', null) == null || isValidName(data.name);
    }

    // users/{uid} – profil uživatele (jméno). Čte ho jen uživatel sám –
    // ostatním se jméno zobrazuje z kopie na soupisce týmu (members).
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && hasValidNameIfAny(request.resource.data);
      allow delete: if false;

      // users/{uid}/teams/{teamId} – přehled týmů daného uživatele a jeho
      // role v nich. Zakládá si ho sám uživatel (při založení týmu nebo
      // připojení kódem). Jinému členovi ho smí upravit správce (změna
      // role, předání vedení, nový kód týmu). Trenér ho jinému členovi smí
      // smazat jen spolu s jeho členstvím v týmu (odebrání hráče, zrušení
      // týmu) – jinak by mohl třeba správci tým schovat z přehledu týmů.
      match /teams/{teamId} {
        allow read: if isMe(uid) || isTeamCoach(teamId);
        allow create, update: if isMe(uid) || isTeamOwner(teamId);
        allow delete: if isMe(uid) || (isTeamCoach(teamId) &&
          !existsAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(uid)));
      }
    }

    // teams/{teamId} – základní údaje týmu (název, kód, správce). ID
    // dokumentu je upravený název týmu (viz TeamService.teamIdFromName).
    match /teams/{teamId} {
      // Nový pozvánkový kód (TeamService.changeCode): stejná dávka musí
      // nový kód zapsat do team_codes (s odkazem na tento tým) a starý
      // odtud smazat – starý kód tak přestane platit pro hledání týmu
      // i pro pravidlo připojení (joinCode se porovnává s kódem týmu).
      function isCodeChange(oldCode, newCode) {
        return newCode is string &&
          getAfter(/databases/$(database)/documents/team_codes/$(newCode)).data.teamId == teamId &&
          !existsAfter(/databases/$(database)/documents/team_codes/$(oldCode));
      }

      allow read: if isTeamMember(teamId);
      // Kdo tým zakládá, je jeho správcem. ID dokumentu musí být upravený
      // název (písmena A–Z malá – lower() diakritiku nepřevádí –, bez
      // okrajových a vícenásobných mezer) – tím
      // databáze sama hlídá unikátní název: založení týmu s už použitým
      // názvem je zápis do existujícího dokumentu, tedy úprava, a tu
      // pravidla níže nedovolí.
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        teamId == request.resource.data.name.lower().trim().replace(' +', ' ');
      // Úpravy týmu smí jen správce a jsou jen dvě:
      //  - předání vedení (TeamService.transferOwnership) – mění se jen
      //    ownerUid a nový správce musí být po dávce trenérem týmu (hráče
      //    stejná dávka povýší),
      //  - nový pozvánkový kód – mění se jen code (viz isCodeChange).
      // Název týmu je zamčený – je zároveň ID dokumentu.
      allow update: if isTeamOwner(teamId) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']) &&
          getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.ownerUid)).data.role == 'coach'
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code']) &&
          isCodeChange(resource.data.code, request.resource.data.code)
        )
      );
      // Zrušení týmu smí jen správce. Batch v TeamService.deleteTeam maže
      // spolu s tímto dokumentem i celý roster, tréninky a team_codes –
      // pravidla pro celou dávku se vyhodnocují vůči stavu databáze před
      // dávkou, takže isTeamOwner(teamId) tu platí, i když se v téže dávce
      // maže i tým samotný.
      allow delete: if isTeamOwner(teamId);

      // teams/{teamId}/members/{uid} – roster týmu
      match /members/{uid} {
        // isMe(uid) navíc (nejen isTeamMember) dovoluje uživateli ověřit
        // si existenci VLASTNÍHO členství ještě předtím, než je členem
        // (TeamService.joinTeamByCode kontroluje, jestli už v týmu není).
        allow read: if isMe(uid) || isTeamMember(teamId);
        // Připojení kódem: kdokoliv přihlášený se smí přidat sám sobě, ale
        // jen jako 'player' a jen se správným pozvánkovým kódem – joinCode
        // v členství se porovná s kódem týmu. Samotná znalost ID týmu
        // (název, nebo ji má třeba odebraný hráč) k připojení nestačí.
        // Odebraný hráč, který kód zná, se vrátit může – proto může správce
        // kód vyměnit za nový (viz update týmu výše).
        // Role 'coach' smí vzniknout jen pro správce týmu při jeho založení
        // (TeamService.createTeam) – tým vzniká ve stejné dávce, proto
        // getAfter() (stav po celé dávce).
        allow create: if isMe(uid) && hasValidNameIfAny(request.resource.data) && (
          (request.resource.data.role == 'player' &&
            request.resource.data.joinCode == get(/databases/$(database)/documents/teams/$(teamId)).data.code) ||
          (request.resource.data.role == 'coach' &&
            getAfter(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid)
        );
        // Roli (povýšení na trenéra i změnu na hráče) mění jen správce a
        // sebe na hráče změnit nemůže – tým by zůstal bez správce-trenéra
        // (TeamService.updateMemberRole má stejnou kontrolu). Člen si navíc
        // smí sám změnit své jméno (AuthService.updateName) – ale nic jiného,
        // hlavně ne roli.
        allow update: if (
          isTeamOwner(teamId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          request.resource.data.role in ['coach', 'player'] &&
          !(uid == teamOwner(teamId) && request.resource.data.role == 'player')
        ) || (
          isMe(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          isValidName(request.resource.data.name)
        );
        // Hráče smí odebrat každý trenér, trenéra jen správce. Správce sám
        // odebrat nejde (TeamService.removeMember má stejnou kontrolu) –
        // výjimkou je zrušení celého týmu (TeamService.deleteTeam), kdy se
        // ve stejné dávce maže i teams/{teamId}, což ověří existsAfter()
        // (existsAfter/getAfter vyhodnocují stav PO celé dávce, ne jen po
        // tomto jednom zápisu).
        allow delete: if (isTeamCoach(teamId) && resource.data.role == 'player') ||
          (isTeamOwner(teamId) && (
            uid != teamOwner(teamId) ||
            !existsAfter(/databases/$(database)/documents/teams/$(teamId))
          ));
      }

      // teams/{teamId}/trainings/{trainingId} – tréninky týmu (viz
      // TrainingService). Odpovědi hráčů jsou v mapě responses (uid -> odpověď).
      match /trainings/{trainingId} {
        function isValidTraining(data) {
          return data.kind in ['team', 'individual'] &&
            data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
            data.type in ['run', 'strength', 'technique', 'recovery', 'other', 'match'] &&
            // Zápas je vždy společná akce celého týmu.
            (data.type != 'match' || data.kind == 'team') &&
            data.startAt is timestamp &&
            (data.get('endAt', null) == null || data.endAt is timestamp) &&
            data.assignedTo is list &&
            (data.kind == 'team' || data.assignedTo.size() > 0) &&
            data.responses is map;
        }

        // Hráč smí v tréninku změnit jen svůj vlastní klíč v responses:
        // u společného tréninku BUDU/NEBUDU ('yes'/'no'), u individuálního
        // jen 'done' a jen pokud je mu trénink zadaný. Smazání klíče
        // (zpět na „bez odpovědi“ / „naplánovaný“) je taky povolené.
        function isOwnResponseUpdate() {
          let uid = request.auth.uid;
          let after = request.resource.data;
          return isTeamMember(teamId) &&
            after.diff(resource.data).affectedKeys().hasOnly(['responses']) &&
            after.responses.diff(resource.data.responses).affectedKeys().hasOnly([uid]) &&
            (!(uid in after.responses) ||
              (after.kind == 'team' && after.responses[uid] in ['yes', 'no']) ||
              (after.kind == 'individual' && uid in after.assignedTo &&
                after.responses[uid] == 'done'));
        }

        // Trenér vidí všechny tréninky týmu, hráč jen společné a individuální
        // zadané jemu. Pravidla nejsou filtr – hráčské dotazy v TrainingService
        // proto samy omezují výsledky (kind == 'team', resp. assignedTo
        // array-contains uid), jinak by je Firestore celé zamítl.
        allow read: if isTeamCoach(teamId) || (isTeamMember(teamId) && (
          resource.data.kind == 'team' || request.auth.uid in resource.data.assignedTo
        ));
        allow create: if isTeamCoach(teamId) &&
          isValidTraining(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.responses.size() == 0;
        allow update: if (isTeamCoach(teamId) && isValidTraining(request.resource.data)) ||
          isOwnResponseUpdate();
        // Mazání i při rušení celého týmu (TeamService.deleteTeam) – pravidla
        // dávky se vyhodnocují vůči stavu před ní, takže trenér tu pořád je.
        allow delete: if isTeamCoach(teamId);

        // .../trainings/{trainingId}/runs/{uid} – GPS záznam běhu hráče
        // (RunService). ID dokumentu je uid hráče, takže na jeden trénink
        // má hráč nejvýš jeden běh – nový přepíše starý.
        match /runs/{uid} {
          function isValidRun(data) {
            return data.keys().hasOnly(['startedAt', 'endedAt', 'durationSeconds', 'distanceMeters', 'points']) &&
              data.startedAt is timestamp &&
              data.endedAt is timestamp &&
              data.durationSeconds is int && data.durationSeconds >= 0 &&
              data.distanceMeters is int && data.distanceMeters >= 0 &&
              data.points is list;
          }

          // Trasu vidí jen hráč sám a trenéři týmu.
          allow read: if isMe(uid) || isTeamCoach(teamId);
          // Běh si ukládá hráč sám a jen k tréninku, který je mu zadaný.
          // Běh uložený bez internetu se odešle až po připojení – pokud
          // mezitím trenér trénink smazal, get() selže a server běh odmítne.
          allow create, update: if isMe(uid) && isTeamMember(teamId) &&
            uid in get(/databases/$(database)/documents/teams/$(teamId)/trainings/$(trainingId)).data.assignedTo &&
            isValidRun(request.resource.data);
          // Hráč maže svůj běh při „Zrušit splnění“, trenér spolu se
          // smazáním tréninku nebo týmu.
          allow delete: if isMe(uid) || isTeamCoach(teamId);
        }
      }
    }

    // team_codes/{code} – vyhledávací mapa "pozvánkový kód -> tým", doc id
    // je přímo kód. Umožňuje připojení k týmu přímým get() podle id, což
    // funguje i pro uživatele, kteří (zatím) nejsou členy žádného týmu –
    // na rozdíl od dotazu nad kolekcí teams (viz komentář v TeamService).
    // list je zakázaný, aby nešlo kódy hromadně vypsat/uhodnout skenováním.
    match /team_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      // Kód vzniká ve stejné dávce jako tým (TeamService.createTeam), nebo
      // jako nový kód týmu (TeamService.changeCode), proto getAfter() – stav
      // po celé dávce. Zapsat jde jen skutečný kód týmu a jeho skutečný
      // název – správce tak nemůže kódy „zabírat“ do zásoby ani k týmu
      // připsat cizí název.
      allow create: if isSignedIn() &&
        getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ownerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.code == code &&
        getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.name == request.resource.data.teamName;
      allow update: if false;
      // Smazání kódu je součástí rušení týmu (TeamService.deleteTeam) –
      // smí jen správce týmu, na který kód odkazuje.
      allow delete: if isTeamOwner(resource.data.teamId);
    }
  }
}
