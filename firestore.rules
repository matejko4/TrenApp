rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Je aktuální uživatel členem daného týmu (jakoukoliv rolí)?
    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamCoach(teamId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach';
    }

    // users/{uid} – veřejný profil uživatele (jméno, email atd.)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isMe(uid);
      allow update: if isMe(uid);
      allow delete: if false;

      // users/{uid}/teams/{teamId} – přehled týmů daného uživatele a jeho
      // role v nich. Zapisuje si ho vždy jen sám uživatel (TeamService ho
      // volá jako aktuálně přihlášený uid, ať zakládá, nebo se připojuje).
      // isTeamCoach(teamId) navíc dovoluje trenérovi týmu zapisovat/mazat
      // tento index i jinému členovi – potřeba pro změnu role člena
      // (TeamService.updateMemberRole) a pro úklid při rušení týmu
      // (TeamService.deleteTeam).
      match /teams/{teamId} {
        allow read, write: if isMe(uid) || isTeamCoach(teamId);
      }
    }

    // teams/{teamId} – základní údaje týmu (název, kód, zakladatel)
    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeamCoach(teamId);
      // Zrušení týmu smí jen trenér. Batch v TeamService.deleteTeam maže
      // spolu s tímto dokumentem i celý roster, team_codes a team_names –
      // pravidla pro celou dávku se vyhodnocují vůči stavu databáze před
      // dávkou, takže isTeamCoach(teamId) tu platí, i když se v téže dávce
      // maže i vlastní členství trenéra.
      allow delete: if isTeamCoach(teamId);

      // teams/{teamId}/members/{uid} – roster týmu
      match /members/{uid} {
        // isMe(uid) navíc (nejen isTeamMember) dovoluje uživateli ověřit
        // si existenci VLASTNÍHO členství ještě předtím, než je členem
        // (TeamService.joinTeamByCode kontroluje, jestli už v týmu není).
        allow read: if isMe(uid) || isTeamMember(teamId);
        // Připojení kódem: kdokoliv přihlášený se smí přidat sám sobě,
        // ale jen jako 'player'. Role 'coach' smí vzniknout jen pro
        // zakladatele týmu (ten už v tuto chvíli existuje – zapisuje se
        // dřív, viz TeamService.createTeam) a ne dodatečným zápisem od kohokoli jiného.
        allow create: if isMe(uid) && (
          request.resource.data.role == 'player' ||
          (request.resource.data.role == 'coach' &&
            get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid)
        );
        // Zakladatele týmu nejde přepnout na hráče (TeamService.updateMemberRole
        // má stejnou kontrolu) – tým by tak mohl zůstat bez trenéra.
        // Člen si navíc smí sám změnit své jméno (AuthService.updateName) –
        // ale nic jiného, hlavně ne roli.
        allow update: if (isTeamCoach(teamId) && !(
          request.resource.data.role == 'player' &&
          uid == get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy
        )) || (
          isMe(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        );
        // Zakladatele nejde z rosteru odebrat samostatně (TeamService.removeMember
        // má stejnou kontrolu) – tým by mohl zůstat bez trenéra. Výjimka je
        // rušení celého týmu (TeamService.deleteTeam): tam se ve stejné dávce
        // maže i teams/{teamId}, což existsAfter() ověří (existsAfter/getAfter
        // vyhodnocují stav PO celé dávce/transakci, ne jen po tomto jednom zápisu).
        allow delete: if isTeamCoach(teamId) && (
          uid != get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy ||
          !existsAfter(/databases/$(database)/documents/teams/$(teamId))
        );
      }

      // teams/{teamId}/trainings/{trainingId} – tréninky týmu (viz
      // TrainingService). Odpovědi hráčů jsou v mapě responses (uid -> odpověď).
      match /trainings/{trainingId} {
        function isValidTraining(data) {
          return data.kind in ['team', 'individual'] &&
            data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
            data.type in ['run', 'strength', 'technique', 'recovery', 'other'] &&
            data.startAt is timestamp &&
            (data.get('endAt', null) == null || data.endAt is timestamp) &&
            data.assignedTo is list &&
            (data.kind == 'team' || data.assignedTo.size() > 0) &&
            data.responses is map;
        }

        // Hráč smí v tréninku změnit jen svůj vlastní klíč v responses:
        // u společného tréninku BUDU/NEBUDU ('yes'/'no'), u individuálního
        // jen 'done' a jen pokud je mu trénink zadaný. Smazání klíče
        // (zpět na „bez odpovědi“ / „naplánovaný“) je taky povolené.
        function isOwnResponseUpdate() {
          let uid = request.auth.uid;
          let after = request.resource.data;
          return isTeamMember(teamId) &&
            after.diff(resource.data).affectedKeys().hasOnly(['responses']) &&
            after.responses.diff(resource.data.responses).affectedKeys().hasOnly([uid]) &&
            (!(uid in after.responses) ||
              (after.kind == 'team' && after.responses[uid] in ['yes', 'no']) ||
              (after.kind == 'individual' && uid in after.assignedTo &&
                after.responses[uid] == 'done'));
        }

        // Trenér vidí všechny tréninky týmu, hráč jen společné a individuální
        // zadané jemu. Pravidla nejsou filtr – hráčské dotazy v TrainingService
        // proto samy omezují výsledky (kind == 'team', resp. assignedTo
        // array-contains uid), jinak by je Firestore celé zamítl.
        allow read: if isTeamCoach(teamId) || (isTeamMember(teamId) && (
          resource.data.kind == 'team' || request.auth.uid in resource.data.assignedTo
        ));
        allow create: if isTeamCoach(teamId) &&
          isValidTraining(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.responses.size() == 0;
        allow update: if (isTeamCoach(teamId) && isValidTraining(request.resource.data)) ||
          isOwnResponseUpdate();
        // Mazání i při rušení celého týmu (TeamService.deleteTeam) – pravidla
        // dávky se vyhodnocují vůči stavu před ní, takže trenér tu pořád je.
        allow delete: if isTeamCoach(teamId);
      }
    }

    // team_codes/{code} – vyhledávací mapa "pozvánkový kód -> tým", doc id
    // je přímo kód. Umožňuje připojení k týmu přímým get() podle id, což
    // funguje i pro uživatele, kteří (zatím) nejsou členy žádného týmu –
    // na rozdíl od dotazu nad kolekcí teams (viz komentář v TeamService).
    // list je zakázaný, aby nešlo kódy hromadně vypsat/uhodnout skenováním.
    match /team_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid;
      allow update: if false;
      // Smazání kódu je součástí rušení týmu (TeamService.deleteTeam) –
      // smí jen trenér týmu, na který kód odkazuje.
      allow delete: if isTeamCoach(resource.data.teamId);
    }

    // team_names/{normalizedName} – vynucení unikátního názvu týmu. Doc id
    // je normalizovaný název (trim + lowercase + sloučené mezery, viz
    // TeamService._normalizeName). Povolený je jen create, ne update –
    // pokus o zápis na už existující název tak Firestore vyhodnotí jako
    // update a zamítne ho, čímž spolehlivě zabrání duplicitám i při
    // souběžném zakládání dvou týmů se stejným názvem.
    match /team_names/{normalizedName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      // Smazání zamluveného názvu je součástí rušení týmu
      // (TeamService.deleteTeam) – smí jen trenér týmu, ke kterému je
      // název přiřazený.
      allow delete: if isTeamCoach(resource.data.teamId);
    }
  }
}
